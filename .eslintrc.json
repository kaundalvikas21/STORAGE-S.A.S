{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "overrides": [
    { "files": ["app/**/*.tsx"], "rules": { "max-lines": ["error", { "max": 120, "skipBlankLines": true, "skipComments": true }] } },
    { "files": ["components/**/*.tsx"], "rules": { "max-lines": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }] } },
    { "files": ["content/**/*.ts"], "rules": { "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }] } },
    { "files": ["lib/**/*.ts"], "rules": { "max-lines": ["error", { "max": 80, "skipBlankLines": true, "skipComments": true }] } },
    { "files": ["lib/types/**/*.ts"], "rules": { "max-lines": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }] } },
    { "files": ["lib/hooks/**/*.ts"], "rules": { "max-lines": ["error", { "max": 40, "skipBlankLines": true, "skipComments": true }] } }
  ]
}
